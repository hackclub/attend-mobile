{
  "expo": {
    "name": "Attend",
    "slug": "attend-scanner",
    "owner": "hack-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "attend",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EC3750"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hackclub.attend",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.hackclub.attend"]
      },
      "infoPlist": {
        "NFCReaderUsageDescription": "Attend uses NFC to scan and write badges for event check-in.",
        "NSCameraUsageDescription": "Attend needs camera access to scan QR codes for event check-in.",
        "NSFaceIDUsageDescription": "Attend uses Face ID to protect sensitive participant information.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "attend.local": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EC3750"
      },
      "package": "com.hackclub.attend",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attend to access your camera for QR code scanning."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EC3750"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "attend-ios",
          "organization": "hack-club-hcb"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "P6PV2R9443"
        }
      ],
      "./plugins/withActivityController.js",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Attend uses NFC to scan and write badges for event check-in.",
          "includeNdefEntitlement": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1eae2e71-70e1-49b2-8b6a-6aeda7e22b93"
      }
    }
  }
}
