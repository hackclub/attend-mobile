{
  "expo": {
    "name": "Attend",
    "slug": "attend-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "attend",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EC3750"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hackclub.attend",
      "infoPlist": {
        "NSCameraUsageDescription": "Attend needs camera access to scan QR codes for event check-in.",
        "NSFaceIDUsageDescription": "Attend uses Face ID to protect sensitive participant information.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EC3750"
      },
      "package": "com.hackclub.attendscanner",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attend to access your camera for QR code scanning."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EC3750"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "attend-ios",
          "organization": "hack-club-hcb"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1eae2e71-70e1-49b2-8b6a-6aeda7e22b93"
      }
    }
  }
}
