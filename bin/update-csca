#!/usr/bin/env bash
# Refresh the CSCA trust anchors the ID check verifies document signatures
# against. Downloads the German BSI CSCA master list (or uses a local .ml/.zip),
# checks its CMS signature, and writes every CSCA certificate in it as PEM to
# the file the mrtd-reader module bundles.
#
# Usage: bin/update-csca [masterlist.ml | masterlist.zip]
#   CSCA_MASTERLIST_URL  override the download URL
#   CSCA_SIGNER_CA       PEM of the German CSCA root, to check the master list
#                        signer was issued by it. Without it only the list's
#                        own signature is checked, and the signer is printed
#                        for you to confirm. The root is published at
#                        https://bsi.bund.de/EN/Themen/Oeffentliche-Verwaltung/Elektronische-Identitaeten/Public-Key-Infrastrukturen/CSCA/Root_Cert_Germany/Root_Certificate_node.html
#                        with its SHA-256 fingerprint: compare before use.
#
# CSCA certificates are valid for years, so running this before each native
# release is enough. Commit the resulting masterList.pem.
set -euo pipefail
cd "$(dirname "$0")/.."

# The zip's URL carries a version parameter that changes with each release, so
# it is read from the download page rather than hard-coded.
BSI="https://www.bsi.bund.de"
PAGE="$BSI/SharedDocs/Downloads/DE/BSI/ElekAusweise/CSCA/GermanMasterList.html"
OUT="modules/mrtd-reader/ios/Resources/masterList.pem"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# cut_bytes FILE OFFSET LENGTH: write LENGTH bytes from OFFSET to stdout.
# head closing the pipe early is expected (SIGPIPE under pipefail); whatever
# is cut is parsed by openssl afterwards, so a bad cut still fails loudly.
cut_bytes() {
  tail -c +"$(($2 + 1))" "$1" | head -c "$3" || true
}

src="${1:-}"
if [ -z "$src" ]; then
  URL="${CSCA_MASTERLIST_URL:-}"
  if [ -z "$URL" ]; then
    path="$(curl -fsSL "$PAGE" | grep -oE 'href="[^"]*GermanMasterList\.zip[^"]*"' | head -n 1 | sed -E 's/^href="//; s/"$//; s/&amp;/\&/g')"
    [ -n "$path" ] || { echo "No master list link found on $PAGE" >&2; exit 1; }
    URL="$BSI$path"
  fi
  echo "Downloading $URL"
  curl -fsSL "$URL" -o "$work/download"
  src="$work/download"
fi

if unzip -tq "$src" >/dev/null 2>&1; then
  unzip -q -o "$src" -d "$work/zip"
  ml="$(find "$work/zip" -type f -name '*.ml' | head -n 1)"
  [ -n "$ml" ] || { echo "No .ml file in $src" >&2; exit 1; }
else
  ml="$src"
fi

# The master list is CMS SignedData. Check its signature against the signer
# certificate it carries and pull out the signed content.
openssl cms -verify -inform DER -in "$ml" -noverify -binary -out "$work/content.der" \
  -signer "$work/signer.pem" 2>/dev/null
echo "Master list signature valid."

if [ -n "${CSCA_SIGNER_CA:-}" ]; then
  # ICAO certificates use explicit EC parameters, which OpenSSL 3 refuses in
  # chain validation (error 94), so `cms -CAfile` can't be used. Instead check
  # by hand that the certificate that signed the list is signed by the given
  # CSCA and is in date. Same reason NFCPassportReader skips that error on
  # device.
  signer="$work/signer.pem"

  openssl x509 -in "$signer" -noout -checkend 0 >/dev/null || { echo "Signer certificate has expired" >&2; exit 1; }
  openssl x509 -in "$signer" -outform DER -out "$work/signer.der"
  # Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue BIT STRING }
  read -r tbs_off tbs_hl tbs_len < <(openssl asn1parse -inform DER -in "$work/signer.der" \
    | sed -nE 's/^ *([0-9]+):d=1 +hl=([0-9]+) +l= *([0-9]+) +cons: SEQUENCE.*/\1 \2 \3/p' | head -n 1)
  read -r sig_off sig_hl sig_len < <(openssl asn1parse -inform DER -in "$work/signer.der" \
    | sed -nE 's/^ *([0-9]+):d=1 +hl=([0-9]+) +l= *([0-9]+) +prim: BIT STRING.*/\1 \2 \3/p' | tail -n 1)
  cut_bytes "$work/signer.der" "$tbs_off" "$((tbs_hl + tbs_len))" > "$work/tbs.der"
  # Skip the BIT STRING's unused-bits byte.
  cut_bytes "$work/signer.der" "$((sig_off + sig_hl + 1))" "$((sig_len - 1))" > "$work/sig.der"
  digest="$(openssl x509 -in "$signer" -noout -text | grep -m 1 'Signature Algorithm' \
    | grep -oiE 'sha(256|384|512)' | tr 'A-Z' 'a-z')"
  [ -n "$digest" ] || { echo "Unsupported signer signature algorithm" >&2; exit 1; }
  openssl x509 -in "$CSCA_SIGNER_CA" -noout -pubkey > "$work/ca.pub"
  openssl dgst -"$digest" -verify "$work/ca.pub" -signature "$work/sig.der" "$work/tbs.der" >/dev/null \
    || { echo "Master list signer is not signed by $CSCA_SIGNER_CA" >&2; exit 1; }
  echo "Signer $(openssl x509 -in "$signer" -noout -subject | sed 's/subject=//') is signed by the given CSCA."
else
  echo "Signer (confirm this is the expected master list signer, or pass CSCA_SIGNER_CA):"
  openssl x509 -in "$work/signer.pem" -noout -subject -issuer | sed 's/^/  /'
fi

# Content is CscaMasterList ::= SEQUENCE { version INTEGER, certList SET OF Certificate }.
# Every certificate is a SEQUENCE at depth 2; cut each one out by offset.
: > "$work/all.pem"
count=0
while read -r offset header length; do
  cut_bytes "$work/content.der" "$offset" "$((header + length))" > "$work/cert.der"
  openssl x509 -inform DER -in "$work/cert.der" -outform PEM >> "$work/all.pem"
  count=$((count + 1))
done < <(
  openssl asn1parse -inform DER -in "$work/content.der" \
    | sed -nE 's/^ *([0-9]+):d=2 +hl=([0-9]+) +l= *([0-9]+) +cons: SEQUENCE.*/\1 \2 \3/p'
)

[ "$count" -gt 0 ] || { echo "No certificates found in $ml" >&2; exit 1; }

# Drop duplicates (the list carries some certificates more than once).
mkdir -p "$(dirname "$OUT")"
awk -v dir="$work" '
  /-----BEGIN CERTIFICATE-----/ { n++; file = dir "/c" n ".pem" }
  { print > file }
' "$work/all.pem"
: > "$OUT.tmp"
for cert in "$work"/c*.pem; do
  fingerprint="$(openssl x509 -in "$cert" -noout -fingerprint -sha256)"
  if ! grep -qxF "$fingerprint" "$work/seen" 2>/dev/null; then
    echo "$fingerprint" >> "$work/seen"
    cat "$cert" >> "$OUT.tmp"
  fi
done
mv "$OUT.tmp" "$OUT"

echo "Wrote $(wc -l < "$work/seen" | tr -d ' ') CSCA certificates to $OUT"
