# .easignore controls which files are uploaded to EAS Build.
#
# IMPORTANT: when this file exists, eas-cli ignores ALL .gitignore files
# entirely and uses only these rules (plus a built-in .git / node_modules
# exclusion). So this file must stay a SUPERSET of .gitignore -- if you add
# something to .gitignore, add it here too.
#
# eas-cli also does NOT respect .git/info/exclude or a global core.excludesfile,
# which is why locally-excluded-but-not-gitignored dirs (.claude) have to be
# listed explicitly.

# --- Dependencies (also excluded by default, listed for clarity) ---
node_modules/

# --- Expo / build output ---
.expo/
dist/
web-build/

# --- Native projects: regenerated by prebuild on EAS, never uploaded ---
/ios/
/android/

# --- Secrets: must never be uploaded ---
.env
.env.local
.env.*.local
credentials.json
credentials/
*.jks
*.keystore

# --- Agent / editor / local tooling state ---
# .claude/worktrees alone was ~3.5 GB of checked-out worktrees.
.claude/
.superpowers/
.idea/
.vscode/
*.swp
*.swo

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Logs, types, tests ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
coverage/

# --- Not needed to build the app ---
docs/
screenshots/
